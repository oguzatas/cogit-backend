# For more info on HTTP files go to https://aka.ms/vs/httpfile
@Web_HostAddress = https://localhost:7219

@Email=administrator@localhost
@Password=Administrator1!
@BearerToken=<YourToken>

###
# POST Users Register
POST {{Web_HostAddress}}/api/Users/Register
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

###
# POST Users Login
POST {{Web_HostAddress}}/api/Users/Login
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

###
# POST Users Refresh
POST {{Web_HostAddress}}/api/Users/Refresh
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "refreshToken": ""
}

###
# POST ScoringScales  [SystemAdmin only]
POST {{Web_HostAddress}}/api/ScoringScales
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "testId": 1,
  "name": "Depression Sub-scale",
  "formulaExpression": "[Q1] + [Q2] + [Q3]"
}

###
# POST Assignments  [TenantStaff only]
POST {{Web_HostAddress}}/api/Assignments
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "testId": 1,
  "clientId": 5
}

###
